		"@wxt-dev/analytics": "^0.5.5",
		"@wxt-dev/i18n": "^0.2.6",
		"lzutf8": "^0.6.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@eslint/css": "^1.4.0",
		"@eslint/js": "^10.0.1",
